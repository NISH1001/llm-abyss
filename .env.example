# ---- docker compose (SearXNG) ----
SEARXNG_HOST=127.0.0.1   # 0.0.0.0 to reach it from other devices (Tailscale, LAN)
SEARXNG_PORT=4243
SEARXNG_SECRET=change-me   # openssl rand -hex 32

# ---- abyss config: fields of abyss.config.Config, upper case. All optional; defaults shown. ----
SEARXNG_URL=http://127.0.0.1:4243
SEARCH_CATEGORIES=general
SEARCH_TIMEOUT=8.0
SEARCH_TOP_K=5
