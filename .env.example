# ---- docker compose (SearXNG) ----
SEARXNG_HOST=127.0.0.1   # 0.0.0.0 to reach it from other devices (Tailscale, LAN)
SEARXNG_PORT=4243
SEARXNG_SECRET=change-me   # openssl rand -hex 32

# ---- abyss settings: fields of abyss.settings.Settings, any case. All optional; defaults shown. ----
SEARXNG_URL=http://127.0.0.1:4243
SEARCH_CATEGORIES=general     # general | science
SEARCH_TIMEOUT=8.0
SEARCH_TOP_K=5                # results kept per query
CRAWL_CONCURRENCY=3           # used once crawling is added
CRAWL_TIMEOUT=6.0
CRAWL_MAX_BYTES=1500000
CHUNK_SIZE=512                # used once chunking is added; approx tokens
CHUNK_OVERLAP=64
CHUNK_TOP_K=3                 # chunks returned to the model

# ---- llama-server (deploy/llm.sh) ----
# LLM_MODELS_DIR=/home/you/models   # default: $HOME/models
LLM_MODEL=Qwen3-1.7B-Q4_K_M.gguf   # file name in LLM_MODELS_DIR, or an absolute path
LLM_HOST=127.0.0.1                 # 0.0.0.0 to reach it over Tailscale/LAN
LLM_PORT=4242
LLM_THREADS=4                      # physical cores
LLM_CTX=4096
LLM_REASONING=off                  # Qwen3 thinking mode: off | on | auto
LLM_CORS_ORIGINS=http://localhost:4242,http://127.0.0.1:4242
LLM_EXTRA_ARGS=                    # other llama-server flags, e.g. --api-key secret --jinja
